ht="26" as="geometry"/></mxCell><mxCell id="n107" value="upper bound of availability, %" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1120" y="400" width="240" height="26" as="geometry"/></mxCell><mxCell id="n108" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="800" y="490" width="560" height="167" as="geometry"/></mxCell><mxCell id="note" value="Calculation rules:<br>offline = devices - online<br>healthScore = HEALTH_MAX - offline*5 - criticalSignals*5 - overloadedNodes*7<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;openIncidents*2&nbsp;-&nbsp;criticalIncidents*10,&nbsp;clamped&nbsp;to&nbsp;0..100<br>onlinePercent = online / devices * 100 (0 when devices == 0)<br>status = STABLE (&gt;= 80), DEGRADED (&gt;= 50), otherwise CRITICAL<br><br>OperationsReport, AppState, MAX_RISKS are the planned data model;<br>the current code keeps only OperationsSummary, the rest is local in main()." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="800" y="490" width="560" height="167" as="geometry"/></mxCell><mxCell id="n109" value="reports[]&lt;br&gt;1 : 0..MAX_REPORTS" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;endArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="appstate" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n110" value="summary&lt;br&gt;1 : 1" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;endArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="report" target="summary"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n111" value="MAX_REPORTS&lt;br&gt;sizes reports[]" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.0000;exitY=0.1366;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3788;entryDx=0;entryDy=0;" edge="1" parent="1" source="consts" target="appstate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n112" value="penalty coefficients,&lt;br&gt;thresholds -&gt;&lt;br&gt;healthScore, status" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.0000;exitY=0.7377;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2381;entryDx=0;entryDy=0;" edge="1" parent="1" source="consts" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n113" value="MAX_RISKS&lt;br&gt;sizes risks[]" style="html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;strokeColor=#666666;exitX=0.0000;exitY=0.9290;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5714;entryDx=0;entryDy=0;" edge="1" parent="1" source="consts" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg" value="solid line with diamond - composition (contains); dashed arrow - constant used by the structure" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="700" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>